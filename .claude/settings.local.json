{
  "permissions": {
    "allow": [
      "Bash(node index.js)",
      "Bash(curl -s http://localhost:3001/api/health)",
      "Bash(curl -s -X POST http://localhost:3001/api/chat -H \"Content-Type: application/json\" -d '{\"message\":\"halo\"}')",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" -X POST http://localhost:3001/api/chat -H \"Content-Type: application/json\" -d '{}')",
      "Bash(kill %1)"
    ]
  }
}