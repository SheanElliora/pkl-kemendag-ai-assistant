# =========================
# OpenRouter Configuration
# =========================
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash

# =========================
# Backend Server
# =========================
PORT=3001

# =========================
# ChromaDB Configuration
# =========================
CHROMA_URL=http://localhost:8000

# =========================
# Auth (JWT)
# =========================
# WAJIB diisi string acak panjang. Server menolak start bila kosong.
JWT_SECRET=ganti-dengan-secret-acak-panjang

# Password untuk user admin pertama yang dibuat otomatis
# saat data/users.json masih kosong. Wajib min. 6 karakter.
DEFAULT_ADMIN_PASSWORD=ganti-password-admin

# =========================
# CORS
# =========================
# Origin yang boleh mengakses API (dipisah koma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Folder Data (override opsional)
# Default sudah sesuai struktur proyek,
# cukup diubah bila ingin memindahkan lokasi.
# =========================
DOCS_PATH=./docs
UPLOADS_PATH=./uploads
DATA_PATH=./data
OCR_PATH=./ocr_text
CHUNKS_PATH=./chunks